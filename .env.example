# ---------------------------------------------------------------------------
# AdProduct configuration
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. Exported environment
# variables win over .env, so the same checkout works under systemd too.
# ---------------------------------------------------------------------------

# --- Amazon Ads ------------------------------------------------------------
AMAZON_REPORTS_URL=https://advertising.amazon.com/reports
# The entityId=... value from the reports page URL.
AMAZON_ENTITY_ID=ENTITY1A2B3C4D5E6F

# Sign-in credentials, filled in automatically when the saved browser session
# has expired. Set both or neither. If Amazon answers with a CAPTCHA or an OTP
# prompt, the run stops and a person runs `python run.py --login`.
AMAZON_EMAIL=
AMAZON_PASSWORD=
AMAZON_AUTO_LOGIN=true

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=powerbidb
DB_USER=powerbi_user
DB_PASSWORD=change-me

# Target table. It is reflected at runtime; only its real columns are written.
DB_TABLE=Advertised_product
DB_DATE_COLUMN=Date
DB_DATE_FORMAT=%Y-%m-%d
# Create the table only if it does not exist at all. Never alters one.
CREATE_TABLE=false

# TLS. Point DB_SSL_CA at a CA bundle when the server requires one.
# DB_SSL_CA=certs/isrgrootx1.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Reports ---------------------------------------------------------------
# Every report the run creates is named "<prefix> SP today 20261029-083000",
# so the run can find its own reports in the list.
REPORT_NAME_PREFIX=AdProduct
# How long Amazon may take to build a report, and how often to check.
REPORT_READY_TIMEOUT_SECONDS=1200
REPORT_POLL_SECONDS=20
DOWNLOAD_TIMEOUT_MS=180000
# Marketplace zone Amazon's Today/Yesterday presets follow. Used to check the
# downloaded dates and to set the browser's clock -- never the server's zone.
REPORT_TIMEZONE=US/Pacific

# --- Paths (relative paths resolve against the project root) ---------------
DOWNLOAD_DIR=data/downloads
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile holding the signed-in Amazon session. Treat as a secret.
SESSION_DIR=data/session
LOCK_FILE=data/adproduct.lock
# A run that finds another one in progress waits this long for it.
LOCK_WAIT_SECONDS=3600

# --- Browser ---------------------------------------------------------------
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SLOW_MO_MS=0
# Extra Chromium flags, comma-separated. --disable-dev-shm-usage is always on.
BROWSER_ARGS=
# Only when Chromium runs as root in a container.
BROWSER_NO_SANDBOX=false

# --- Retry -----------------------------------------------------------------
# Transient failures only. Auth/CAPTCHA/MFA are never retried.
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping ----------------------------------------------
LOG_LEVEL=INFO
# logs/adproduct.log rotates at UTC midnight; older files are deleted after this.
LOG_RETENTION_DAYS=5
# Leftover downloads/screenshots (failed or dry runs) are deleted after this.
FILE_RETENTION_DAYS=30
# Reports are deleted once loaded. true keeps a copy in PROCESSED_DIR.
KEEP_PROCESSED_FILES=false
