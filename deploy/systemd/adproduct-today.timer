# Today's reports every 3 hours, on the hour, India time:
# 00:00 03:00 06:00 09:00 12:00 15:00 18:00 21:00 IST.
# The timezone is part of the schedule, so the server's own zone is irrelevant
# (needs systemd 235+: Ubuntu 18.04+, Amazon Linux 2023, RHEL 8+).
[Unit]
Description=AdProduct: today's reports every 3 hours (IST)

[Timer]
OnCalendar=*-*-* 00/3:00:00 Asia/Kolkata
RandomizedDelaySec=60
Unit=adproduct@today.service

[Install]
WantedBy=timers.target
